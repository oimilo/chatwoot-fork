# Configuração do Hack
CW_EDITION=ee
DISABLE_ENTERPRISE=false

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot_test
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://:redis123@redis:6379
REDIS_PASSWORD=redis123

# Secrets
SECRET_KEY_BASE=replace_with_lengthy_secure_hex
OTP_SECRET=replace_with_lengthy_secure_hex

# Frontend
FRONTEND_URL=http://localhost:3000

# Rails
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_LOG_LEVEL=info

# Installation
INSTALLATION_ENV=docker
INSTALLATION_NAME=Chatwoot Hack Test

# Features
ENABLE_ACCOUNT_SIGNUP=false
ENABLE_EMAIL_CHANNEL=false

# Mailer
MAILER_SENDER_EMAIL=Chatwoot <chatwoot@example.com>
SMTP_DOMAIN=localhost
SMTP_ADDRESS=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=

# Storage
ACTIVE_STORAGE_SERVICE=local

# Logging
LOG_LEVEL=info
LOG_SIZE=500